NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Preferred for new projects; legacy projects can use NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-legacy-anon-key

# Public application origin used for authentication email redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional AI explanation. Choose a provider explicitly; Finder scoring works without it.
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-api-key
# OPENAI_MODEL=your-openai-model
# AI_PROVIDER=anthropic
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ANTHROPIC_MODEL=your-anthropic-model

# Optional Mapbox GL JS map. Create a public token at https://account.mapbox.com/access-tokens/.
# Keep the token public-scoped and never hardcode it in source code.
# NEXT_PUBLIC_MAPBOX_TOKEN=pk.your-public-mapbox-token
